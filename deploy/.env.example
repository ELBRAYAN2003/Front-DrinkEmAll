# Copiar a .env en el servidor y completar con valores generados.
# NO versionar el .env real.
#
# Para generar los secretos:
#   openssl rand -base64 36

DB_DATABASE=drinkemall
DB_USERNAME=drinkemall
DB_PASSWORD=
DB_ROOT_PASSWORD=

JWT_SECRET=
JWT_REFRESH_SECRET=

# Poner en true solo en el primer arranque, para cargar el catalogo.
SEED_ON_START=false

# Prefijo del registro de imagenes. Dejar vacio usa Docker Hub. Si la cuota de
# descargas anonimas de Hub esta agotada, apuntar a un espejo:
#   REGISTRY=mirror.gcr.io/library
REGISTRY=docker.io/library
