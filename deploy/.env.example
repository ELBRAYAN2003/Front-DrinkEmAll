# Copiar a .env en el servidor y completar con valores generados.
# NO versionar el .env real.
#
# Para generar los secretos:
#   openssl rand -base64 36

DB_DATABASE=drinkemall
DB_USERNAME=drinkemall
DB_PASSWORD=
DB_ROOT_PASSWORD=

JWT_SECRET=
JWT_REFRESH_SECRET=

# Poner en true solo en el primer arranque, para cargar el catalogo.
SEED_ON_START=false

# Prefijo del registro de imagenes. Dejar vacio usa Docker Hub. Si la cuota de
# descargas anonimas de Hub esta agotada, apuntar a un espejo:
#   REGISTRY=mirror.gcr.io/library
REGISTRY=docker.io/library

# --- Cuentas del comercio ---------------------------------------------------------------
# El admin ya existente en un servidor viejo conserva su contrasena: cambiarla con
# scripts/set-password.js (ver docs/despliegue.md). Estas dos solo sirven para CREARLO la primera vez.
ADMIN_EMAIL=admin@drinkemall.com
ADMIN_PASSWORD=
# Vendedor del comercio: a su nombre se asientan los pedidos online. Se crea una vez con el seeder
# 20261117100001-vendedor-tienda. ONLINE_SELLER_EMAIL debe ser el mismo correo.
VENDEDOR_EMAIL=
VENDEDOR_PASSWORD=
ONLINE_SELLER_EMAIL=

# --- Mercado Pago (credenciales de PRODUCCION de la aplicacion) --------------------------
# Se obtienen en el panel de Mercado Pago Developers > tu aplicacion. Sin token no se ofrece.
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta de la firma de webhooks (Webhooks > Configurar notificaciones).
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_SANDBOX=false
MERCADOPAGO_PREFILL_PAYER_EMAIL=false

# --- Datos del local ---------------------------------------------------------------------
# Todo esto se edita despues desde el panel del comercio (Datos del local); aca solo son valores
# iniciales y lo guardado en el panel manda sobre estas variables.
SHIPPING_COST=3000
FREE_SHIPPING_FROM=40000
PICKUP_ADDRESS=
PICKUP_HOURS=
TRANSFER_ALIAS=
TRANSFER_CBU=
TRANSFER_HOLDER=
TRANSFER_CUIT=
TRANSFER_INSTRUCTIONS=
# Minutos que se reserva el stock mientras se espera un pago por adelantado.
PAYMENT_WINDOW_MINUTES=180
