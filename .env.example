# URL base de la API. El backend monta todo bajo /api y escucha en el 3000.
# Si queda vacia, el front usa el catalogo de maqueta de src/data/home.js.
VITE_API_URL=http://localhost:3000/api

# Origen desde donde el backend sirve las fotos de producto (/uploads/...).
VITE_API_FILES=http://localhost:3000
